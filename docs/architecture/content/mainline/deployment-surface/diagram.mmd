flowchart TB
    subgraph entry["发布入口"]
        direction TB
        A[发布控制台]
    end

    subgraph control["控制层"]
        direction LR
        B[控制面] --> C[策略网格]
    end

    subgraph runtime["运行层"]
        direction LR
        D[运行单元]
        E[运维工具]
    end

    A --> B
    C --> D
    C --> E

    classDef warm fill:#fff7ec,stroke:#aa6232,color:#1f2c2d,stroke-width:1.5px;
    classDef teal fill:#ecf7f5,stroke:#0f766e,color:#1f2c2d,stroke-width:1.5px;
    classDef neutral fill:#fffdfa,stroke:#8ea0a2,color:#1f2c2d,stroke-width:1.5px;
    class A,D warm;
    class B,C teal;
    class E neutral;

    style entry fill:#fbf1e4,stroke:#ddcdb8,color:#6f5d4a;
    style control fill:#eef7f4,stroke:#ddcdb8,color:#4f6662;
    style runtime fill:#f7f3eb,stroke:#ddcdb8,color:#6f5d4a;

    linkStyle default stroke:#8e6746,stroke-width:1.6px;
