    class A,B warm;
    class C,D teal;

    style legacy fill:#fbf1e4,stroke:#ddcdb8,color:#6f5d4a;
    style output fill:#eef7f4,stroke:#ddcdb8,color:#4f6662;

    linkStyle default stroke:#8e6746,stroke-width:1.6px;
